<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ciprian-localpulse</groupId>
    <artifactId>kitfiscal-client</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>kitfiscal-client</name>
    <description>Client Java pentru kitfiscal API — estimator fiscal PFA / SRL Micro / SRL Profit, Romania 2026.</description>
    <url>https://github.com/Ciprian-LocalPulse/kitfiscal-client-java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/Ciprian-LocalPulse/kitfiscal-client-java/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ciprian Ștefan Pleșca</name>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Ciprian-LocalPulse/kitfiscal-client-java</url>
        <connection>scm:git:https://github.com/Ciprian-LocalPulse/kitfiscal-client-java.git</connection>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <!--
        Fara dependinte de runtime (foloseste java.net.http.HttpClient, standard
        din JDK 11+, si un parser JSON minimal inclus in pachet) — evita
        conflictele de versiune tipice cu Jackson/Gson in module Spring Boot
        mari, unde clientii externi cu dependinte proprii sunt adesea o
        problema de "dependency hell".
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <!--
        NU folosim distributionManagement clasic (URL Nexus/OSSRH) — contul
        Sonatype creat prin Central Portal (central.sonatype.com) nu suportă
        deploy direct cu maven-deploy-plugin către un URL arbitrar. Publicarea
        se face exclusiv prin central-publishing-maven-plugin, mai jos, care
        împachetează artefactele într-un bundle și le trimite prin API-ul
        oficial al Portal-ului.
    -->

    <!--
        Profil activat explicit doar la publicare (mvn deploy -P release),
        nu la `mvn test` obișnuit din CI — semnarea GPG ar eșua fără cheie
        configurată, deci n-ar trebui să ruleze la fiecare push normal.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!--
                                Cheia GPG folosita pentru semnare nu are
                                passphrase. gpgArguments de mai jos forteaza
                                modul non interactiv (batch, fara prompt),
                                ca sa nu ramana blocat asteptand o fereastra
                                care nu va aparea niciodata intr-un runner
                                CI fara terminal.
                            -->
                            <gpgArguments>
                                <arg>--batch</arg>
                                <arg>--yes</arg>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>

                    <!--
                        Pluginul oficial pentru Sonatype Central Portal —
                        singurul mecanism suportat pentru conturile create
                        prin central.sonatype.com (nu Nexus/OSSRH clasic).
                        Se leaga automat de faza "deploy" (extensions=true),
                        deci `mvn deploy -P release` il activeaza fara alt
                        goal explicit.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- trebuie sa coincida cu <server-id> din
                                 actions/setup-java, in workflow -->
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
